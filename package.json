{
  "name": "isekai-jikjak",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:root": "vite site-root --host 127.0.0.1 --port 5174 --strictPort",
    "icons:build": "node scripts/build-brand-icons.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"*.ts\" README.md \"docs/**/*.md\"",
    "data:sync": "node scripts/sync-rules.mjs",
    "character:sync": "node scripts/sync-character.mjs",
    "api:dev": "wrangler dev --port 8787",
    "api:check": "wrangler deploy --dry-run --outdir .cache/worker",
    "api:deploy": "wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.2",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.133.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
